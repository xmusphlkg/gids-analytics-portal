{
  "name": "gids-analytics",
  "version": "3.0.0",
  "description": "GIDS audience analytics on Cloudflare Pages and D1",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public",
    "db:init:local": "wrangler d1 execute gid-telemetry-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute gid-telemetry-db --remote --file=./schema.sql",
    "deploy": "wrangler pages deploy public --project-name=gid-analytics-portal"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
